# --- Database (Neon Postgres) ---
DATABASE_URL=                   # Neon > Connect > pooled connection string (starts with postgresql://)

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=                 # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=       # from WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=          # any random string you choose (used when adding the webhook)
META_APP_SECRET=                # App settings > Basic > App secret
WHATSAPP_API_VERSION=v21.0      # optional; check Meta docs for the current version

# --- App ---
APP_URL=https://your-project.vercel.app   # public base URL (used for CSV export links)
CRON_SECRET=                    # random string; Vercel sends it as a Bearer token to cron routes
EXPORT_SECRET=                  # random string; signs CSV export links
ALLOWED_PHONES=                 # optional: comma-separated numbers (923001234567) allowed to use the bot. Empty = everyone
NEXT_PUBLIC_WA_NUMBER=          # optional: your bot number (923001234567) for the landing page button

# --- Gemini (free key from aistudio.google.com): REQUIRED for voice notes, also used as a fallback for messy text ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
